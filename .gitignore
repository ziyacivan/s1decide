# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/

# uv / venv
.venv/
uv.lock.bak

# tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# project data — regenerated by `uv run task data`
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# The manifest is provenance (counts, licences, leakage), not data — keep it.
!data/processed/manifest.json

# Unsloth writes generated modules into the CWD when it is imported (e.g. by `task doctor`)
unsloth_compiled_cache/

# large local artefacts
artifacts/
outputs/
*.gguf
*.safetensors

# results/ IS committed (metrics.json + plots) — do not ignore it

# OS
Thumbs.db
.DS_Store

# Announcement drafts are written locally and never committed.
docs/announce/

# External-model evaluation slices carry full states; predictions and metrics are committed.
results/**/slice-*.jsonl
# Training checkpoints hold adapter weights and optimiser state (GB); the run's evals and summary are committed.
results/*/checkpoints/
